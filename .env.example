# Chỉ dành cho ứng dụng Quản lý Đảng viên PTIT.
# Tạo database và credentials riêng; không dùng URL của ứng dụng Đoàn viên.
DATABASE_URL="postgresql://dang_vien_app:change-me@localhost:5432/quan_ly_dang_vien?schema=public"

# Thay bằng secret ngẫu nhiên riêng trước khi chạy ứng dụng.
AUTH_SECRET="replace-with-a-dedicated-random-secret"

# Thư mục lưu tệp riêng của ứng dụng.
STORAGE_ROOT="./storage"
